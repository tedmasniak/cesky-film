#!/bin/bash
# Stub of MyDevil's "devil" CLI. Logs every call; only the commands used by the
# deployment are recognised. Real syntax: https://pomoc.mydevil.net/Cache/
echo "$(date -u +%FT%TZ) devil $*" >> "$HOME/devil.log"
if [[ "$1 $2" == "www options" && "$4" == "cache" ]]; then
  case "$5" in control|short|long|purge|off) echo "OK"; exit 0;; esac
fi
echo "devil (local stub): unsupported command: $*" >&2
exit 1
